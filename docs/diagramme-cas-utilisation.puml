@startuml

skinparam usecase {
    BackgroundColor #F0F0F0
    BorderColor #444444
}
skinparam rectangle {
    BorderColor #003366
    BackgroundColor #E0E0FF
    FontColor #003366
    StereotypeFontColor #003366
    BorderThickness 2
}
skinparam package {
    BackgroundColor #FFFFFF
    BorderColor #555555
    BorderThickness 1.5
    FontColor #003366
}

' ==== 1. ACTEURS ====
left to right direction

actor "Visiteur" as Visiteur
actor "Étudiant\nauthentifié" as Etudiant
actor "Membre BDE\n(Admin)" as Admin
actor "Système\nd'email" as MailSystem
actor "Service\nCloudinary" as CloudinaryService

' Héritage : Un Admin est un Étudiant, qui est lui-même un Visiteur
Etudiant -up-|> Visiteur
Admin -up-|> Etudiant

' ==== 2. FRONTIÈRE DU SYSTÈME ====
rectangle "Système Web BDE Live" {

    ' --- PARTIE DÉCONNECTÉE (Accès Public) ---
    package "Espace Public" #E8F6F3 {
        usecase "S'inscrire\n(Créer compte)" as UC_Inscription
        usecase "Se connecter" as UC_Login
        usecase "Réinitialiser\nMot de Passe" as UC_ResetPwd
        
        ' Pages informatives
        usecase "Consulter\nMentions Légales" as UC_Legal
        usecase "Consulter\nPlan du Site" as UC_Sitemap
        usecase "Consulter\nl'équipe BDE" as UC_Equipe
        usecase "Visualiser\nÉvénements/Articles" as UC_ViewContent
        
        ' Détail Reset Pwd
        usecase "Suivre lien email\nréinitialisation" as UC_FollowLink
        UC_ResetPwd ..> UC_FollowLink : <<include>>
    }

    ' --- PARTIE CONNECTÉE (Membres) ---
    package "Espace Membre" #E8F8F5 {
        usecase "Gérer son Profil" as UC_Profile
        usecase "Se déconnecter" as UC_Logout
        usecase "S'inscrire / Désinscrire\nd'un Événement" as UC_RegisterEvent
        usecase "Consulter\nemploi du temps" as UC_Schedule
        
        UC_Profile ..> UC_Logout : <<include>>
    }

    ' --- ADMINISTRATION (BDE) ---
    package "Espace Administration" #FADBD8 {
        usecase "CRUD\nÉvénements" as UC_ManageEvents
        usecase "CRUD\nArticles" as UC_ManageArticles
        usecase "Gérer\nles Médias" as UC_ManageMedia
        usecase "Gérer\nles Membres" as UC_ManageMembers
        
        ' Gestion des médias incluse dans la gestion de contenu
        UC_ManageEvents ..> UC_ManageMedia : <<include>>
        UC_ManageArticles ..> UC_ManageMedia : <<include>>
    }

    ' --- SERVICES SYSTÈME ---
    package "Services Backend" #FEF9E7 {
        usecase "Envoyer Email\nTransactionnel" as UC_SendEmail
        usecase "Validation Compte\n(Email)" as UC_VerifyEmail
        
        UC_Inscription ..> UC_VerifyEmail : <<include>>
        UC_ResetPwd ..> UC_SendEmail : <<include>>
    }
}

' ==== ASSOCIATIONS ACTEURS ↔ CAS D'UTILISATION ====

' Visiteur (Accès Public)
Visiteur --> UC_Inscription
Visiteur --> UC_Login
Visiteur --> UC_ResetPwd
Visiteur --> UC_Legal
Visiteur --> UC_Sitemap
Visiteur --> UC_Equipe
Visiteur --> UC_ViewContent

' Étudiant (Hérite de Visiteur + Fonctionnalités Membre)
Etudiant --> UC_Profile
Etudiant --> UC_RegisterEvent
Etudiant --> UC_Schedule

' Admin (Hérite d'Étudiant + Fonctionnalités Admin)
Admin --> UC_ManageEvents
Admin --> UC_ManageArticles
Admin --> UC_ManageMembers

' Systèmes Externes
MailSystem --> UC_SendEmail
MailSystem --> UC_VerifyEmail
CloudinaryService --> UC_ManageMedia

@enduml
