@startuml
!theme plain
skinparam packageStyle rectangle
left to right direction

title Use Case Diagram - BdeLive Platform

' ==================== ACTORS (outside boundary) ====================
actor "Visitor" as Visitor
actor "Student" as Student
actor "BDE Admin" as Admin
actor "Super Admin" as SuperAdmin

Visitor <|-- Student
Student <|-- Admin
Admin <|-- SuperAdmin

' ==================== SYSTEM BOUNDARY ====================
rectangle "BdeLive Platform" {

  ' ==================== USE CASES ====================
  usecase "View schedule" as UC_Schedule
  usecase "View events and articles" as UC_Consult
  usecase "Register for an event" as UC_Register
  usecase "Create/Join a team" as UC_Team
  usecase "Manage personal data (GDPR)" as UC_Privacy
  usecase "Manage events, articles and users" as UC_Manage
  usecase "Export participant lists (PDF)" as UC_Export
  usecase "Authenticate" as UC_Auth
  usecase "Manage roles (Promote/Demote)" as UC_Roles

  ' ==================== INCLUDE/EXTEND DEPENDENCIES ====================
  UC_Register .> UC_Auth : <<include>>
  UC_Team .> UC_Register : <<extend>>
}

' ==================== ACTOR -> USE CASE ASSOCIATIONS ====================
Visitor --> UC_Schedule
Visitor --> UC_Consult
Student --> UC_Register
Student --> UC_Privacy
Admin --> UC_Manage
Admin --> UC_Export
SuperAdmin --> UC_Roles

@enduml
