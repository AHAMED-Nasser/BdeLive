@startuml
!theme plain
skinparam packageStyle rectangle
left to right direction

title Diagramme de Cas d'Utilisation - Administrateur BDE

actor "Admin BDE" as Admin

rectangle "Plateforme BdeLive" {
  usecase "Créer, modifier, supprimer\ndes événements" as UC_Events
  usecase "Créer, modifier, supprimer\ndes articles" as UC_Articles
  usecase "Modérer les utilisateurs\n(Bloquer/Débloquer)" as UC_Moderate
  usecase "Exporter les listes en PDF\n(Participants et Utilisateurs)" as UC_Export
}

Admin --> UC_Events
Admin --> UC_Articles
Admin --> UC_Moderate
Admin --> UC_Export

@enduml
