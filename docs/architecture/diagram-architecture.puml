@startuml
!theme plain
skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam packageStyle rectangle

title Software Architecture - BdeLive

' ==================== CORE LAYER ====================
package "Core" #E8F4F8 {
  class Application {
    + boot(): void
    + request(): Request
    + response(): Response
  }
  class Request {
    + get(), post(), method()
  }
  class Container {
    + get(id): object
    + set(id, builder): self
  }
  class Database {
    + getConnection(): PDO
  }
}

' ==================== CONTROLLERS LAYER ====================
package "Controllers" #F0E8F8 {
  abstract class AbstractController {
     render(view, data): void
     redirect(url): never
  }
}

' ==================== VIEWS LAYER ====================
package "Views (PHP templates)" #F8F0E8 {
  class View <<Concept>> {
    Data passed via render()
    Escaped HTML output
  }
}

' ==================== DOMAIN LAYER (Event example) ====================
package "Domain" #F0F8E8 {

  note as ExampleNote
    **Architecture Note:**
    The "Event" domain is used here as an illustrative example.
    The exact same Data Mapper flow
    (Controller ➔ Repository ➔ Factory ➔ Entity)
    is strictly applied to the "Article" domain.
  end note

  package "Repositories" {
    class EventRepository {
      - pdo: PDO
      + findById(id): Event|null
      + save(event: Event): bool
    }
  }
  package "Factories" {
    class EventFactory {
      + createFromDatabase(data): Event
      + toDatabase(event): array
    }
  }
  package "Entities" {
    class Event {
      Pure domain object
      No database logic
    }
  }
}

' ==================== FLOW - CLEAN ARCHITECTURE (..> = dependency) ====================
Application ..> Request : 1. Receives HTTP request
Application ..> Container : 2. Asks for controller via DI
Container ..> AbstractController : 3. Instantiates and injects dependencies

AbstractController ..> EventRepository : 4. Requests domain data
EventRepository ..> Database : 5. Executes SQL query
EventRepository ..> EventFactory : 6. Delegates data mapping
EventFactory ..> Event : 7. Creates entity

EventRepository ..> Event : 8. Returns entity
AbstractController ..> Event : 9. Receives entity
AbstractController ..> View : 10. Passes data to view
@enduml
