@startuml BdeLive - Diagramme de classes
!theme plain
skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam packageStyle rectangle

title Diagramme de classes - BdeLive (MVC + Data Mapper)

' ==================== CORE ====================
package "Core" #E8F4F8 {
  class Application <<Singleton>> {
    - {static} instance: Application|null
    - session: SessionManager
    - request: Request
    - response: Response
    - csrf: CsrfProtection
    - auth: AuthManager
    __
    - __construct()
    + {static} getInstance(): self
    + boot(): void
    + session(): SessionManager
    + request(): Request
    + response(): Response
    + csrf(): CsrfProtection
    + auth(): AuthManager
  }

  class Database <<Singleton>> {
    - {static} instance: Database|null
    - pdo: PDO
    __
    - __construct()
    + {static} getInstance(): Database
    + getConnection(): PDO
  }

  class Container {
    - bindings: array
    - instances: array
    __
    + set(id, builder): self
    + has(id): bool
    + get(id): object
    - resolveClass(class): object
  }

  class ContainerFactory <<static>> {
    + {static} create(): Container
  }

  class Request {
    + get(name, default): mixed
    + post(name, default): mixed
    + file(name): array|null
    + isPost(): bool
    + server(key, default): mixed
  }

  class Response {
    + redirect(url, statusCode): never
    + setHeader(name, value): void
    + setStatusCode(code): void
    + send(): void
  }
}

' ==================== ENTITIES (Domain) ====================
package "Entities" #F0F8E8 {
  class Article {
    - id: int|null
    - title: string
    - slug: string
    - description: string
    - imageUrl: string|null
    - author: string
    - createdAt: string
    __
    + __construct(...)
    + getId(): int|null
    + getTitle(): string
    + getSlug(): string
    + getDescription(): string
    + getImageUrl(): string|null
    + getAuthor(): string
    + getCreatedAt(): string
    + setTitle(string): void
    + setSlug(string): void
    + setDescription(string): void
    + setImageUrl(string|null): void
    + setAuthor(string): void
    + getShortDescription(limit): string
    + getFormattedDate(): string
    + hasImage(): bool
  }

  class Event {
    - id: int|null
    - name: string
    - slug: string
    - date: string
    - time: string
    - location: string
    - theme: string
    - statusParticipating: string
    - description: string
    - images: string
    - isGroupEvent: bool
    - teamSize: int
    __
    + __construct(...)
    + getId(): int|null
    + getName(): string
    + getSlug(): string
    + getDate(): string
    + getTime(): string
    + getLocation(): string
    + getTheme(): string
    + getStatusParticipating(): string
    + getDescription(): string
    + getImages(): string
    + isGroupEvent(): bool
    + getTeamSize(): int
    + setName(string): void
    + setDate(string): void
    + setTime(string): void
    + setLocation(string): void
    + setDescription(string): void
    + setImages(string): void
    + isPast(): bool
    + getFormattedDate(): string
    + getImagesArray(): array
    + hasImages(): bool
  }
}

' ==================== REPOSITORY INTERFACES ====================
package "Repositories (Interfaces)" #FFF8E8 {
  interface ArticleRepositoryInterface {
    + findById(id: int): Article|null
    + findBySlug(slug: string): Article|null
    + findPaginated(offset, limit): Article[]
    + findLatestArticles(limit: int): Article[]
    + save(article: Article): bool
    + delete(id: int): bool
    + count(): int
  }

  interface EventRepositoryInterface {
    + findById(id: int): Event|null
    + findBySlug(slug: string): Event|null
    + findAll(): Event[]
    + findPaginated(offset, limit): Event[]
    + findLatestEvents(limit: int): Event[]
    + findEventsForHomepage(limit: int): Event[]
    + save(event: Event): bool
    + delete(id: int): bool
    + count(): int
  }
}

' ==================== FACTORIES ====================
package "Factories" #F5E8F8 {
  class ArticleFactory <<static>> {
    + {static} createFromDatabase(data: array): Article
    + {static} createCollectionFromDatabase(dataSet: array): Article[]
    + {static} toDatabase(article: Article): array
  }

  class EventFactory <<static>> {
    + {static} createFromDatabase(data: array): Event
    + {static} createCollectionFromDatabase(dataSet: array): Event[]
    + {static} toDatabase(event: Event): array
  }
}

' ==================== REPOSITORIES (Implementations) ====================
package "Repositories (Implementations)" #E8F0F8 {
  class ArticleRepository {
    - pdo: PDO
    __
    + __construct(pdo: PDO)
    + findById(id: int): Article|null
    + findBySlug(slug: string): Article|null
    + findPaginated(offset, limit): Article[]
    + findLatestArticles(limit: int): Article[]
    + save(article: Article): bool
    + delete(id: int): bool
    + count(): int
    - insert(article: Article): bool
    - update(article: Article): bool
  }

  class EventRepository {
    - pdo: PDO
    __
    + __construct(pdo: PDO)
    + findById(id: int): Event|null
    + findBySlug(slug: string): Event|null
    + findAll(): Event[]
    + findPaginated(offset, limit): Event[]
    + findLatestEvents(limit: int): Event[]
    + findEventsForHomepage(limit: int): Event[]
    + save(event: Event): bool
    + delete(id: int): bool
    + count(): int
    - insert(event: Event): bool
    - update(event: Event): bool
  }
}

' ==================== CONTROLLERS (exemples) ====================
package "Controllers" #F0E8F8 {
  abstract class BaseController {
    # app: Application
    # request: Request
    # response: Response
    # session: SessionManager
    # csrf: CsrfProtection
    # auth: AuthManager
    __
    # redirect(url: string): never
    # setSuccess(message: string): void
    # setError(message: string): void
    # render(view: string, data: array): void
  }

  class HomeController {
    + __construct()
  }

  class ArticlesController {
    - repository: ArticleRepositoryInterface
    + __construct(repository: ArticleRepositoryInterface)
    - displaySingleArticle(slug): void
    - displayArticlesList(): void
  }

  class ShowEventController {
    - eventRepository: EventRepositoryInterface
    + __construct(eventRepository: EventRepositoryInterface)
  }
}

' ==================== ENTRY POINT ====================
package "Entry point" #E8E8E8 {
  class Router {
    Résout page → FQCN Controller
    container = ContainerFactory::create()
    container.get(ResolvedController)
  }
}

' ==================== RELATIONS ====================
Application *-- Database : uses
Application *-- Request : owns
Application *-- Response : owns

ContainerFactory ..> Container : creates
ContainerFactory ..> ArticleRepositoryInterface : binds
ContainerFactory ..> EventRepositoryInterface : binds
Router --> ContainerFactory : create()
Router --> Container : get(Controller)

ArticleRepository ..|> ArticleRepositoryInterface : implements
EventRepository ..|> EventRepositoryInterface : implements

ArticleRepository o-- Article : returns/accepts
EventRepository o-- Event : returns/accepts

ArticleRepository --> Database : getConnection()
EventRepository --> Database : getConnection()

ArticleFactory ..> Article : creates
EventFactory ..> Event : creates
ArticleRepository ..> ArticleFactory : uses
EventRepository ..> EventFactory : uses

BaseController <|-- HomeController : extends
BaseController <|-- ArticlesController : extends
BaseController <|-- ShowEventController : extends

ArticlesController --> ArticleRepositoryInterface : injecté
ShowEventController --> EventRepositoryInterface : injecté

note right of Article
  **Model (domain)**
  Entité métier
  getShortDescription,
  getFormattedDate, hasImage
end note

note right of ArticleRepository
  **Model (data)**
  Data Mapper: PDO → Entity
  via ArticleFactory
end note

note bottom of Container
  **DI** : set() pour les services,
  get() avec auto-wiring
  pour les contrôleurs
end note

note as MVC
  **MVC**
  **Model** : Entities (Article, Event) + Repositories + Factories
  **View** : app/Modules/views/*.php (données via render())
  **Controller** : Controllers, reçoivent Repository (DI), appellent render(view, data)
  Flux : Router → Container.get(Controller) → Controller utilise Repository → render(View, data)
end note

@enduml
