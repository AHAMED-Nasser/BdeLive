@startuml Création événement
skinparam sequenceMessageAlign center
skinparam shadowing false

title Diagramme de séquence : Création d'un événement (Admin/BDE)

actor "Membre BDE" as Admin
participant "CreateEventController" as EC
participant "AuthManager" as AM
participant "CloudinaryService" as CS
participant "EventCreationModel" as EM
participant "Database" as DB

Admin -> EC : POST /createEvent (données + images)
activate EC

EC -> AM : requireAdmin()
activate AM
AM -> AM : check status == 'BDE'
AM --> EC : void | Exception
deactivate AM

alt Accès refusé
    EC --> Admin : Erreur 403 (Accès interdit)
else Accès autorisé
    EC -> EC : validate form data

    alt Images présentes
        EC -> CS : uploadMultipleImages(files)
        activate CS
        CS --> EC : urls[]
        deactivate CS
    end

    EC -> EM : insertEvent(name, date, time, location, theme, status, description, images)
    activate EM
    EM -> DB : INSERT INTO events (...)
    activate DB
    DB --> EM : success
    deactivate DB
    EM --> EC : true | false
    deactivate EM

    EC --> Admin : Redirection (Liste événements + Flash)
end

deactivate EC
@enduml

