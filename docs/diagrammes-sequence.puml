@startuml Inscription événement
skinparam sequenceMessageAlign center
skinparam shadowing false

title Diagramme de séquence : Inscription à un événement

actor "Utilisateur" as User
participant "RegisterEventController" as REC
participant "AuthManager" as AM
participant "EventRegistrationRepository" as ERR
participant "Database" as DB

User -> REC : GET /registerEvent?action=register&event_id=X
activate REC

REC -> AM : requireAuthentication()
activate AM
AM --> REC : OK | Exception
deactivate AM

REC -> AM : getUserId()
activate AM
AM --> REC : user_id
deactivate AM

REC -> ERR : isUserRegistered(event_id, user_id)
activate ERR
ERR -> DB : SELECT 1 FROM event_registrations WHERE event_id = ? AND user_id = ?
activate DB
DB --> ERR : result
deactivate DB
ERR --> REC : bool
deactivate ERR

alt Déjà inscrit
    REC --> User : Message d'erreur (Déjà inscrit)
else Pas encore inscrit
    REC -> ERR : registerUser(event_id, user_id)
    activate ERR
    ERR -> DB : INSERT INTO event_registrations (event_id, user_id, status)
    activate DB
    DB --> ERR : success
    deactivate DB
    ERR --> REC : success
    deactivate ERR

    REC --> User : Redirection (Événement + Flash Success)
end

deactivate REC
@enduml

