@startuml Réinitialisation mot de passe
skinparam sequenceMessageAlign center
skinparam shadowing false

title Diagramme de séquence : Réinitialisation de mot de passe

actor "Visiteur" as User
participant "ForgotPasswordController" as FPC
participant "PasswordReset" as PR
participant "Database" as DB
participant "Mailer" as M
participant "VerifyTokenController" as VTC
participant "ResetPasswordController" as RPC

== Phase 1 : Demande de réinitialisation ==

User -> FPC : POST /forgotPassword (email)
activate FPC

FPC -> PR : getUserByEmail(email)
activate PR
PR -> DB : SELECT * FROM users WHERE email = ?
activate DB
DB --> PR : user_data | null
deactivate DB
PR --> FPC : user | false
deactivate PR

alt Utilisateur non trouvé
    FPC --> User : Message d'erreur
else Utilisateur trouvé
    FPC -> PR : createToken(user_id)
    activate PR
    PR -> PR : bin2hex(random_bytes(32))
    PR -> DB : INSERT INTO password_reset_token (...)
    activate DB
    DB --> PR : success
    deactivate DB
    PR --> FPC : token
    deactivate PR

    FPC -> M : sendPasswordResetEmail(email, name, token)
    activate M
    M --> FPC : success
    deactivate M

    FPC --> User : Message : Email envoyé
end

deactivate FPC

== Phase 2 : Vérification du token ==

User -> VTC : GET /verifyToken?token=XXX
activate VTC

VTC -> PR : verifyToken(token)
activate PR
PR -> DB : SELECT * FROM password_reset_token WHERE token = ?
activate DB
DB --> PR : token_data
deactivate DB
PR --> VTC : {valid: bool, user_id}
deactivate PR

alt Token invalide ou expiré
    VTC --> User : Erreur : Token invalide
else Token valide
    VTC --> User : Formulaire nouveau mot de passe
end

deactivate VTC

== Phase 3 : Nouveau mot de passe ==

User -> RPC : POST /resetPassword (token, password)
activate RPC

RPC -> PR : updatePassword(user_id, password)
activate PR
PR -> DB : UPDATE users SET password = ? WHERE user_id = ?
activate DB
DB --> PR : success
deactivate DB
PR --> RPC : success
deactivate PR

RPC -> PR : markTokenAsUsed(token)
activate PR
PR -> DB : UPDATE password_reset_token SET is_used = 1
activate DB
DB --> PR : success
deactivate DB
deactivate PR

RPC --> User : Redirection (Login + Flash Success)

deactivate RPC
@enduml

