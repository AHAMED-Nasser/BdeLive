@startuml Inscription utilisateur
skinparam sequenceMessageAlign center
skinparam backgroundColor #FEFEFE
skinparam shadowing false


actor "Visiteur" as User
participant "RegisterController" as RC
participant "UserManager" as UM
participant "Database" as DB
participant "AuthManager" as AM

User -> RC : POST /register (données)
activate RC

RC -> RC : validateCsrf(token)
alt Token CSRF invalide
    RC --> User : Erreur 403 (Token invalide)
else Token valide
    RC -> UM : isEmailExists(email)
    activate UM
    UM -> DB : SELECT COUNT(*) FROM users WHERE email = ?
    activate DB
    DB --> UM : count
    deactivate DB
    UM --> RC : exists (bool)
    deactivate UM

    alt Email déjà pris
        RC --> User : Message d'erreur : Email déjà utilisé
    else Email disponible
        RC -> UM : createUser(lastName, firstName, status, email, password)
        activate UM
        UM -> UM : password_hash(pwd)
        UM -> DB : INSERT INTO users (...)
        activate DB
        DB --> UM : user_id
        deactivate DB
        UM --> RC : user_id
        deactivate UM

        RC -> AM : login(user_id, status, email, firstName, lastName)
        activate AM
        AM -> AM : session_regenerate_id()
        AM --> RC : success
        deactivate AM

        RC --> User : Redirection (Accueil + Flash Success)
    end
end

deactivate RC
@enduml

@startuml Connexion utilisateur
skinparam sequenceMessageAlign center
skinparam shadowing false

title Diagramme de séquence : Connexion d'un utilisateur

actor "Visiteur" as User
participant "LoginController" as LC
participant "AuthManager" as AM
participant "UserManager" as UM
participant "Database" as DB

User -> LC : POST /login (email, password)
activate LC

LC -> LC : validateCsrf(token)

LC -> AM : login(email, password)
activate AM

AM -> UM : findByEmail(email)
activate UM
UM -> DB : SELECT * FROM users WHERE email = ?
activate DB
DB --> UM : user_data
deactivate DB
UM --> AM : user_array | false
deactivate UM

alt Utilisateur introuvable
    AM --> LC : false (LoginException)
else Utilisateur trouvé
    AM -> AM : password_verify(password, hash)
    alt Mot de passe incorrect
        AM --> LC : false (LoginException)
    else Mot de passe correct
        AM -> AM : initializeSession(user)
        AM --> LC : true
    end
end
deactivate AM

alt Erreur Authentification
    LC --> User : Message d'erreur (Identifiants invalides)
else Succès Authentification
    LC --> User : Redirection (Dashboard ou Accueil)
end

deactivate LC
@enduml

