RewriteEngine On
Options -MultiViews

# Laisser passer sitemap.xml, robots.txt et fichier de vérification Google
RewriteRule ^sitemap\.xml$ - [L]
RewriteRule ^robots\.txt$ - [L]
RewriteRule ^google0d2c8b071cff9901\.html$ - [L]

# Front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ app/index.php?page=$1 [QSA,L]