RewriteEngine On
Options -MultiViews

Options -Indexes

RedirectMatch 404 /\.git

<FilesMatch "\.(env|sql|log|json|lock|yml|yaml)$|composer\.(json|lock)|package(-lock)?\.json$">
    Require all denied
</FilesMatch>

RewriteRule ^app/(Config|Core|include|services|Modules)/ - [F,L]

RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(sitemap\.xml|robots\.txt|google0d2c8b071cff9901\.html)$ - [L]

RewriteCond %{REQUEST_URI} ^/app/assets/
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d


RewriteRule ^$ app/index.php?page=home [L,QSA]

RewriteRule ^(.*)$ app/index.php?page=$1 [QSA,L]
