RewriteEngine On
Options -MultiViews

Options -Indexes

RedirectMatch 404 /\.git
<FilesMatch "(\.(env|json|lock|xml|yml|yaml|sql|log)|composer\.(json|lock))$">
    Require all denied
</FilesMatch>

<FilesMatch "^(sitemap\.xml|robots\.txt|google.*\.html)$">
    Require all granted
</FilesMatch>

RewriteCond %{REQUEST_URI} ^/app/
RewriteCond %{REQUEST_URI} !^/app/assets/
RewriteCond %{REQUEST_URI} !^/app/(index\.php|robots\.txt|sitemap\.xml)$
RewriteRule ^ - [F,L]

RewriteRule ^sitemap\.xml$ app/sitemap.xml [L]
RewriteRule ^robots\.txt$ app/robots.txt [L]


RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ app/index.php?page=$1 [QSA,L]