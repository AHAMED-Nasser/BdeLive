RewriteEngine On
Options -MultiViews

# Laisser passer sitemap.xml et robots.txt
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(sitemap\.xml|robots\.txt|google0d2c8b071cff9901\.html)$ - [L]

# Front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ app/index.php?page=$1 [QSA,L]