{
  "name": "bdelive/app",
  "description": "BDE Live PHP project",
  "type": "project",
  "require": {
    "php": "^8.2",
    "phpmailer/phpmailer": "^7.0",
    "cloudinary/cloudinary_php": "^3.1",
    "ext-pdo": "*",
    "dompdf/dompdf": "^3.1",
    "vlucas/phpdotenv": "^5.6",
    "erusev/parsedown": "^1.8"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.11",
    "squizlabs/php_codesniffer": "^3.10",
    "phpunit/phpunit": "^12.5.8"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "phpstan": "phpstan analyse --level=8 app",
    "lint": "phpcs app",
    "lint:fix": "phpcbf app",
    "test": "phpunit",
    "doc": [
      "test -f phpDocumentor.phar || curl -LO https://phpdoc.org/phpDocumentor.phar",
      "php phpDocumentor.phar --config=none -d ./app -t ./docs/api --ignore \"vendor/,app/assets/\""
    ],
    "post-install-cmd" : [
      "@doc"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
