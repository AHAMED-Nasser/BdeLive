<?xml version="1.0"?>
<ruleset name="BdeLive">
    <description>PHP CodeSniffer configuration for BdeLive project</description>
    
    <!-- Include the entire app directory -->
    <file>app</file>
    
    <!-- Exclude non-PHP files -->
    <exclude-pattern>*/assets/*</exclude-pattern>
    <exclude-pattern>*.js</exclude-pattern>
    <exclude-pattern>*.css</exclude-pattern>
    <exclude-pattern>*.json</exclude-pattern>
    <exclude-pattern>*.xml</exclude-pattern>
    <exclude-pattern>*.md</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    
    <!-- Use PSR-12 standard with relaxed rules for legacy code -->
    <rule ref="PSR12">
        <exclude name="Generic.Files.LineLength"/>
        <exclude name="PSR1.Files.SideEffects.FoundWithSymbols"/>
    </rule>
    <!-- Line length: 500 chars (PSR12 default 120 too strict for views/HTML) -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="500"/>
        </properties>
    </rule>
</ruleset>
