<?xml version="1.0"?>
<ruleset name="BdeLive PSR-12 (relaxed)">
    <description>PSR-12 with relaxed namespace requirement for legacy code.</description>

    <rule ref="PSR12">
        <exclude name="Generic.Files.LineLength"/>
        <exclude name="PSR1.Files.SideEffects.FoundWithSymbols"/>
    </rule>
    <!-- Line length: 500 chars (PSR12 default 120 too strict for HTML/views) -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="500"/>
        </properties>
    </rule>

    <!-- Paths to scan - exclude assets directory which contains JS/CSS files -->
    <file>app/Core</file>
    <file>app/Config</file>
    <file>app/Modules</file>
    <file>app/Services</file>
    <file>app/include</file>
    <file>app/index.php</file>
    <file>app/rooter.php</file>
    <file>app/robots.txt</file>
    <file>app/sitemap.xml</file>

    <!-- Ignore files that intentionally contain no PHP code -->
    <exclude-pattern>app/modules/models/public/PaginationModel.php</exclude-pattern>

    <!-- Explicitly exclude assets directory (contains JS/CSS files that PHPCS cannot analyze) -->
    <exclude-pattern>app/assets</exclude-pattern>

    <!-- Coding style settings -->
    <arg name="extensions" value="php"/>
</ruleset>

